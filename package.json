{
  "name": "fourtime-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run arquitetura && npm run classes && npm run menu && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "arquitetura": "depcruise src",
    "contas": "sh testes/contas.sh",
    "visual": "node testes/visual.mjs && python3 testes/comparar.py",
    "espelho": "sh testes/espelho.sh",
    "visual:aprovar": "python3 testes/comparar.py --aprovar",
    "classes": "node testes/classes.mjs",
    "menu": "node testes/menu-config.mjs",
    "arquivo": "sh testes/arquivo-ficha.sh",
    "sessao": "sh testes/sessao.sh",
    "semana": "sh testes/semana.sh",
    "tipos": "sh testes/tipos.sh",
    "conferir": "npm run tipos && npm run classes && npm run titulos && npm run tokens && npm run ligacoes && npm run contas && npm run semana && npm run boleto && npm run cuidados",
    "titulos": "node testes/titulos.mjs",
    "cuidados": "node testes/cuidados.mjs",
    "tokens": "node testes/tokens.mjs",
    "ligacoes": "node testes/ligacoes.mjs",
    "prova": "node testes/prova.mjs",
    "arrasto": "node testes/arrasto.mjs",
    "cartao": "node testes/cartao.mjs",
    "boleto": "sh testes/boleto.sh",
    "materiais": "node testes/materiais.mjs",
    "transporte": "node testes/transporte.mjs",
    "porteiro": "node --experimental-strip-types testes/porteiro.mjs",
    "parceiros": "node testes/parceiros.mjs",
    "deposito": "node testes/deposito.mjs",
    "estoque": "node testes/estoque.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  }
}
