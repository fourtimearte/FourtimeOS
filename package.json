{
  "name": "fourtime-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run arquitetura && npm run classes && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "arquitetura": "depcruise src",
    "contas": "sh testes/contas.sh",
    "visual": "node testes/visual.mjs && python3 testes/comparar.py",
    "espelho": "sh testes/espelho.sh",
    "visual:aprovar": "python3 testes/comparar.py --aprovar",
    "classes": "node testes/classes.mjs",
    "arquivo": "sh testes/arquivo-ficha.sh",
    "sessao": "sh testes/sessao.sh"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  }
}
