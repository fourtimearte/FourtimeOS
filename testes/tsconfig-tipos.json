{
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": null,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "baseUrl": "..",
    "types": [],
    "paths": {
      "@ds": ["src/ds/index.ts"],
      "@ds/*": ["src/ds/*"],
      "@dominio": ["src/dominio/index.ts"],
      "@dominio/*": ["src/dominio/*"],
      "@shared": ["src/shared/index.ts"],
      "@shared/*": ["src/shared/*"],
      "@modules/*": ["src/modules/*"]
    }
  },
  "include": ["../src", "./tipos-falsos.d.ts"]
}
