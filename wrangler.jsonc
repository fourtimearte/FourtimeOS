{
  // Configuracao da publicacao no Cloudflare.
  // O sistema e uma pagina so com rotas no navegador (react-router), entao qualquer
  // endereco que nao seja arquivo precisa devolver o index.html em vez de 404.
  // E isso que "single-page-application" faz.
  //
  // Desde 11/11/2026 ha tambem um script (worker/index.ts): a PONTE DO DRIVE,
  // que guarda e entrega as artes dos orcamentos no Google Drive. Ele so roda
  // nos enderecos /api/*; todo o resto continua indo direto aos arquivos.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fourtimeos",
  "compatibility_date": "2026-09-11",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // nao sao segredo: o endereco do projeto e publico, e o id da pasta so
    // abre alguma coisa para quem tem a chave do Google (que e segredo, e
    // mora no painel da Cloudflare)
    "SUPABASE_URL": "https://uwbniyqixpwacnwybfis.supabase.co",
    "DRIVE_PASTA": ""
  }
}
